{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alfred.draft-pr-result/1",
  "type": "object",
  "required": ["schema", "project", "task_id", "destination", "base_branch", "publication_branch", "commit", "publication_plan_sha256", "qa_report_sha256", "review_report_sha256", "draft_pr_url", "status", "detail", "next_stage"],
  "properties": {
    "schema": {"const": "alfred.draft-pr-result/1"},
    "project": {"type": "string"}, "task_id": {"type": "string"},
    "destination": {"type": "string"}, "base_branch": {"type": "string"},
    "publication_branch": {"type": "string"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "publication_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qa_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "draft_pr_url": {"type": ["string", "null"]},
    "status": {"enum": ["PUBLISHED_DRAFT", "ERROR"]},
    "detail": {"type": ["string", "null"]},
    "next_stage": {"enum": ["alfred_completion_notification", "publication_investigation"]}
  },
  "additionalProperties": false
}
