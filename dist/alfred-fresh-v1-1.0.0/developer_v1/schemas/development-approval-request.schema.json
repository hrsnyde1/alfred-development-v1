{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alfred.development-approval-request/1",
  "type": "object",
  "required": ["schema", "state", "project", "task_id", "spec_sha256", "plan_sha256", "repository", "worktree_root", "scope", "specialists"],
  "properties": {
    "schema": {"const": "alfred.development-approval-request/1"},
    "state": {"const": "pending_owner_decision"},
    "project": {"type": "string"},
    "task_id": {"type": "string"},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "string"},
    "worktree_root": {"type": "string"},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "specialists": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
