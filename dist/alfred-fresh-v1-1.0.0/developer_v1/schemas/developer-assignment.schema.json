{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alfred.developer-assignment/1",
  "type": "object",
  "required": ["id", "project", "task_id", "specialist", "files", "depends_on", "objective"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_-]{1,64}$"},
    "project": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
    "task_id": {"type": "string", "pattern": "^T-[0-9]{4}$"},
    "specialist": {"type": "string"},
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "objective": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
