+    try:
+        source = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        try:
+            info = os.fstat(source)
+            if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= _RESTRICTED_MEDIA_MAX_BYTES:
+                raise ValueError("unsupported Photon media file")
+            target = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
+                             0o640, dir_fd=directory)
+            try:
+                os.fchmod(target, 0o640)
+                remaining = info.st_size
+                while remaining:
+                    chunk = os.read(source, min(1024 * 1024, remaining))
+                    if not chunk:
+                        raise ValueError("Photon media changed during staging")
+                    view = memoryview(chunk)
+                    while view:
+                        view = view[os.write(target, view):]
+                    remaining -= len(chunk)
+                os.fsync(target)
+            finally:
+                os.close(target)
+            os.rename(temporary, media_id, src_dir_fd=directory, dst_dir_fd=directory)
+            os.fsync(directory)
+        finally:
+            os.close(source)
+        return directory, media_id
+    except BaseException:
+        for entry in (temporary, media_id):
+            try:
+                os.unlink(entry, dir_fd=directory)
+            except FileNotFoundError:
+                pass
+        os.close(directory)
