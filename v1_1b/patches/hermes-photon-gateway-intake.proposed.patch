+def _spool_restricted_media(path: str) -> tuple[int, str]:
+    """Copy approved Hermes media to the one directory visible to the protected sidecar."""
+    root = _get_scoped_secret("PHOTON_HERMES_MEDIA_SPOOL") or ""
