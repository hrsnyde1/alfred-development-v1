# Future authorized operator command only; instances are fixed command tokens.
[Unit]
Description=Confined Photon test control, reconnect (%i)
AssertPathExists=/srv/photon-reply-test/root/app/MANIFEST.sha256
Requisite=photon-reply-test@reconnect.service
After=photon-reply-test@reconnect.service

[Service]
Type=oneshot
User=photon-reply-test
Group=photon-reply-test
UMask=0077
RootDirectory=/srv/photon-reply-test/root
WorkingDirectory=/app
ExecStart=/app/bin/node /app/scripts/operator-control.mjs reconnect %i
BindReadOnlyPaths=/usr:/usr /etc/ssl/certs:/etc/ssl/certs
BindPaths=/run/photon-reply-test-reconnect:/run/photon-reply-test-reconnect
MountAPIVFS=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
IPAddressDeny=any
SocketBindDeny=any
KeyringMode=private
LimitNOFILE=32
TasksMax=8
MemoryMax=128M
TimeoutStartSec=10s
TimeoutStopSec=5s
Restart=no
StandardInput=null
StandardOutput=journal
StandardError=journal
